# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (dentro de Docker el host es el servicio `db`)
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleetpass
POSTGRES_DB=fleetcore

# TypeORM connection (local)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=fleet
DB_PASSWORD=fleetpass
DB_DATABASE=fleetcore

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# API keys (protección de endpoints de integración, separadas por coma)
API_KEYS=dev-key-1,dev-key-2
